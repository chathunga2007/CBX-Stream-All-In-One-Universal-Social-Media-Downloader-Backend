# ==============================================================================
# CBX-Stream Universal Social Media Downloader Backend - Environment Variables
# ==============================================================================

# Application Configuration
PROJECT_NAME="CBX Stream Universal Media Downloader"
VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS Settings (comma-separated origins or * for all)
CORS_ORIGINS=["*"]

# Storage & Directory Settings
TEMP_DIR=temp_downloads
LOG_DIR=logs
MAX_FILE_SIZE_BYTES=5368709120

# Concurrency & Timeouts
MAX_CONCURRENT_TASKS=5
DOWNLOAD_TIMEOUT_SECONDS=1800

# Cleanup Background Worker
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_TTL_SECONDS=3600

# FFmpeg Executable Paths (leave blank or 'ffmpeg' to auto-detect system/imageio-ffmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Network & Extraction Settings
PROXY_URL=
COOKIES_FILE=
COOKIES_FROM_BROWSER=
NODE_PATH=
