# flyctl launch added from .gitignore
# Byte-compiled / optimized / DLL files
**/__pycache__
**/*.py[cod]
**/*$py.class

# Environments & Secrets
**/.env
**/.venv
**/env
**/venv
**/ENV
**/cookies.txt
**/*cookies*.txt

# Temp Downloads & Artifacts
**/temp_downloads/*
!**/temp_downloads/.gitkeep

# Logs
**/logs/*
!**/logs/.gitkeep
**/*.log

# IDE files
**/.vscode
**/.idea
**/*.sublime-project
**/*.sublime-workspace
**/.DS_Store
**/node_modules
**/bgutil-pot-server

